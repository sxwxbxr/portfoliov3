# SMTP configuration for contact form emails
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Portfolio Contact <no-reply@example.com>"
CONTACT_RECIPIENT=your-destination@example.com

# NeonDB (serverless Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT Auth
JWT_SECRET=your-random-64-char-secret

# OpenRouter (powers all AI features — chat, contact analysis, deep dive, pitch, skill explorer)
OPENROUTER_API_KEY=sk-or-v1-...

# Vercel Blob (image uploads in the admin).
# On Vercel, create a Blob store under Storage and this is injected
# automatically. Without it the upload button reports that no store is
# connected and the image field still accepts a pasted path or URL, so the
# admin keeps working — it just cannot upload.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel KV / Upstash Redis (durable global daily cap for the public AI routes).
# On Vercel, link a KV store and these are injected automatically. The code also
# accepts the UPSTASH_REDIS_REST_* equivalents. AI routes fail open if unset.
KV_REST_API_URL=https://your-store.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-rest-token

# Package site blog: shared secret for POST /api/revalidate (webhook from a remote blog source).
BLOG_REVALIDATE_TOKEN=

# Package site blog: shared secret for the ingest API (/api/packages/posts) that an external
# blog system (Schulz Media) uses to push posts. Empty = ingest switched off. See docs/BLOG_INTEGRATION.md.
BLOG_INGEST_TOKEN=
# Name stored as the source of pushed posts (default: schulz-media).
BLOG_INGEST_SOURCE=
# Schulz Media content API (blog posts written and approved there, rendered on packages.sweber.dev/blog).
# Server-side only, never NEXT_PUBLIC_. Without a key the source is skipped.
SCHULZ_MEDIA_API_KEY=
# Optional override of the API base (default https://www.schulz-media.ch/api/content/v1).
SCHULZ_MEDIA_API_URL=
# Where posts come from: "all" (default: database + Schulz Media API + content/blog Markdown) or "local" (Markdown only).
BLOG_SOURCE=

# Optional. Production builds use https://packages.sweber.dev automatically (via NEXT_PUBLIC_VERCEL_ENV);
# local dev and previews serve the package site at /packages. Set this to override the origin.
NEXT_PUBLIC_PACKAGES_URL=

# Polar order webhook (POST /api/polar/webhook, event order.paid): sends the buyer a purchase
# confirmation with the customer portal link, blind copy to CONTACT_RECIPIENT. Uses the SMTP_* settings above.
# Secret from Polar → Settings → Webhooks. Empty = webhook answers 503 and Polar retries.
POLAR_WEBHOOK_SECRET=
# Optional sender for these mails (default SMTP_FROM), e.g. "sweber.dev <info@sweber.dev>".
ORDER_MAIL_FROM=
# Optional Polar access token (scopes customer_sessions:write, customers:read, members:read): adds a direct
# portal sign-in link to the confirmation mail, for mailboxes that never receive Polar's sign-in code.
POLAR_ACCESS_TOKEN=

# ── physio.sweber.dev (student platform, app/physio) ─────────────────────────
# Optional. Production builds use https://physio.sweber.dev automatically (via NEXT_PUBLIC_VERCEL_ENV);
# local dev and previews serve the platform at /physio. Set this to override the origin. Also the base
# of every link in the account mails (never the Host header); without it mails use the request origin + /physio.
NEXT_PUBLIC_PHYSIO_URL=
# Signs the physio_session cookie (HS256, 30 days). Min. 32 characters, e.g. `openssl rand -base64 48`.
# REQUIRED for sign-in. Must NOT be the same as JWT_SECRET: the admin middleware accepts any token that
# verifies against JWT_SECRET, and there is deliberately no fallback between the two.
PHYSIO_JWT_SECRET=
# "off" opens every paid tool to everyone, even without an account (testing, soft launch). Anything else = paywall on.
PHYSIO_PAYWALL=
# Sender of the physio mails (verification, password reset). Default SMTP_FROM, e.g. "Physio Tools <physio@sweber.dev>".
PHYSIO_MAIL_FROM=
# Polar API access token, shared with the package shop (POLAR_ACCESS_TOKEN above). For physio it needs the scopes
# checkouts:write and customer_sessions:write (customers:read and members:read stay for the package mail).
# POLAR_ACCESS_TOKEN=
# "sandbox" talks to sandbox-api.polar.sh (use a sandbox token, product IDs and webhook secret then); anything else = production.
POLAR_SERVER=
# Polar product IDs (UUIDs) of the two subscription plans. Either may stay empty; with both empty /abo shows "starts soon".
PHYSIO_POLAR_PRODUCT_MONTHLY=
PHYSIO_POLAR_PRODUCT_YEARLY=
# Price texts shown on /abo, plain strings (the real amount is set in Polar and shown again at checkout), e.g. "3 CHF pro Monat".
PHYSIO_PRICE_MONTHLY_LABEL=
PHYSIO_PRICE_YEARLY_LABEL=
# Separate Polar webhook endpoint https://physio.sweber.dev/api/physio/polar/webhook, events subscription.*
# (created, updated, active, canceled, uncanceled, revoked, past_due; paused, resumed, cycled optional). Empty = 503, Polar retries.
PHYSIO_POLAR_WEBHOOK_SECRET=
